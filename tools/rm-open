#!/usr/bin/python3
"""Opens a path printed on a server, using the matching file in a Remote Mounts folder.

  rm-open PATH [WORKING_DIR] [LINE]

Meant for iTerm2's semantic history ("Always run command…"): ⌘-click on
/home/josu/report/chart.png in an ssh session opens ~/contabo/report/chart.png.
Local files and URLs open as usual, so it can replace the default ⌘-click.
A dialog asks whether to open the file, download a copy to ~/Downloads (the app
shows the progress) or show it in Finder. Remote Mounts' settings can skip it and always open or always download;
--no-confirm (passed first) always opens.
"""
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import urllib.parse

CONFIG = os.path.expanduser("~/Library/Application Support/RemoteMounts/mounts.json")
DOWNLOADS = os.path.expanduser("~/Downloads")
APP_ID = "dev.josu.RemoteMounts"
# Home folders as they appear on Linux and macOS servers
REMOTE_HOME = re.compile(r"^/(?:home/[^/]+|root|Users/[^/]+)(?:/(.*))?$")


def clean(text):
    """Strips what iTerm2 may include around a path: quotes, brackets, punctuation, :line:col."""
    text = text.strip().strip("\"'`()[]<>{},;")
    line = None
    m = re.match(r"^(.*?):(\d+)(?::\d+)?:?$", text)
    if m and not re.match(r"^[a-z][a-z0-9+.-]*://", text, re.I):
        text, line = m.group(1), m.group(2)
    return text.rstrip(".:"), line


def mounted_servers():
    """(remote folder, local mount folder) for every Remote Mounts server that is mounted now."""
    try:
        with open(CONFIG) as f:
            configs = json.load(f)
    except (OSError, ValueError):
        return []
    out = []
    for c in configs:
        mp = os.path.expanduser(c.get("mountPoint", ""))
        if mp and os.path.ismount(mp):
            out.append((c.get("remotePath", ""), mp))
    return out


def local_candidates(path, remote_root, mount_point):
    """Where `path` (as printed on the server) would be inside this mount, if anywhere."""
    if path.startswith("~/") or path == "~":
        rest = path[2:]
    else:
        m = REMOTE_HOME.match(path)
        rest = (m.group(1) or "") if m else None
    root = remote_root.rstrip("/")
    if remote_root.startswith("/") and root == "":  # the whole server
        if path.startswith("/"):
            yield mount_point + path
    elif root in ("", "~"):  # mount shows the remote home folder
        if rest is not None:
            yield os.path.join(mount_point, rest)
    elif root.startswith("~/"):  # a folder inside the remote home
        sub = root[2:]
        if rest is not None and (rest == sub or rest.startswith(sub + "/")):
            yield os.path.join(mount_point, rest[len(sub):].lstrip("/"))
    elif path == root or path.startswith(root + "/"):
        yield mount_point + path[len(root):]


def find(path, pwd):
    if path.startswith("/") and os.path.exists(path):
        return path
    if not path.startswith(("/", "~")):
        # Relative: the working directory iTerm2 knows (local, or remote with shell integration)
        if not pwd:
            return None
        path = os.path.normpath(os.path.join(pwd, path))
        if os.path.exists(path):
            return path
    for remote_root, mount_point in mounted_servers():
        for cand in local_candidates(path, remote_root, mount_point):
            if os.path.exists(cand):
                return cand
    return None


# An NSAlert rather than `display dialog`, which allows only three buttons.
# Arguments come in through argv so paths need no escaping.
CONFIRM_SCRIPT = """
ObjC.import("AppKit");
function run(argv) {
    const [shown, name, buttons, appPath] = [argv[0], argv[1], argv[2].split("|"), argv[3]];
    const app = $.NSApplication.sharedApplication;
    app.setActivationPolicy(1 /* accessory */);
    app.activateIgnoringOtherApps(true);
    const alert = $.NSAlert.alloc.init;
    alert.messageText = "Open \u201c" + name + "\u201d?";
    alert.informativeText = shown;
    if (appPath) alert.icon = $.NSWorkspace.sharedWorkspace.iconForFile(appPath);
    buttons.forEach(b => alert.addButtonWithTitle(b));
    alert.window.level = 8;  // modal panel level, above iTerm2
    return buttons[alert.runModal - 1000] || "Cancel";
}
"""

# The fallback if the alert can't be shown
DIALOG_SCRIPT = """
on run argv
    set {thePath, theName} to argv
    try
        set reply to display dialog "Open “" & theName & "”?" & return & return & thePath ¬
            with title "Remote Mounts" buttons {"Cancel", "Show in Finder", "Open"} ¬
            default button "Open" cancel button "Cancel" with icon note
        return button returned of reply
    on error number -128
        return "Cancel"
    end try
end run
"""


def click_action():
    """What a ⌘-click on a server file does, from Remote Mounts' settings: ask, open or download."""
    r = subprocess.run(["/usr/bin/defaults", "read", APP_ID, "clickAction"], capture_output=True, text=True)
    action = r.stdout.strip()
    return action if action in ("open", "download") else "ask"


def app_path():
    r = subprocess.run(["/usr/bin/mdfind", f"kMDItemCFBundleIdentifier == '{APP_ID}'"],
                       capture_output=True, text=True)
    paths = [p for p in r.stdout.splitlines() if p.endswith(".app")]
    return paths[0] if paths else ""


def confirm(path, remote):
    """Asks what to do; returns "Open", "Download", "Show in Finder" or "Cancel"."""
    shown = path.replace(os.path.expanduser("~"), "~", 1)
    name = os.path.basename(path.rstrip("/")) or path
    buttons = ["Open", "Download", "Show in Finder", "Cancel"] if remote else ["Open", "Show in Finder", "Cancel"]
    r = subprocess.run(["/usr/bin/osascript", "-l", "JavaScript", "-e", CONFIRM_SCRIPT,
                        shown, name, "|".join(buttons), app_bundle()], capture_output=True, text=True)
    if r.returncode == 0 and r.stdout.strip():
        return r.stdout.strip()
    r = subprocess.run(["/usr/bin/osascript", "-e", DIALOG_SCRIPT, shown, name],
                       capture_output=True, text=True)
    return r.stdout.strip() or "Cancel"


def notify(msg):
    subprocess.run(["/usr/bin/osascript", "-e",
                    f"display notification {json.dumps(msg, ensure_ascii=False)} with title \"Remote Mounts\""])


def unique_name(folder, name):
    """"chart.png", then "chart 2.png", "chart 3.png"…, like Finder."""
    stem, ext = os.path.splitext(name)
    if name.startswith(".") and not ext:
        stem, ext = name, ""
    n = 1
    while True:
        cand = os.path.join(folder, name if n == 1 else f"{stem} {n}{ext}")
        if not os.path.lexists(cand):
            return cand
        n += 1


def app_bundle():
    """The Remote Mounts app this script belongs to, else wherever Spotlight finds it."""
    bundle = os.path.realpath(__file__).rpartition(".app/")
    return bundle[0] + ".app" if bundle[1] else app_path()


def download(path):
    """Hands the download to Remote Mounts, which shows its progress; copies it here if that fails."""
    app = app_bundle()
    if app:
        url = "remotemounts://download?path=" + urllib.parse.quote(path, safe="")
        if subprocess.run(["/usr/bin/open", "-g", "-a", app, url]).returncode == 0:
            return 0
    return copy_here(path)


def copy_here(path):
    """Copies a file or folder from the mount into ~/Downloads and shows it in Finder."""
    name = os.path.basename(path.rstrip("/"))
    os.makedirs(DOWNLOADS, exist_ok=True)
    big = os.path.isdir(path) or os.path.getsize(path) > 20_000_000
    if big:
        notify(f"Downloading {name}…")
    # Copy into a hidden folder first, so a half-copied file never looks finished
    tmp = tempfile.mkdtemp(prefix=".remote-mounts-", dir=DOWNLOADS)
    try:
        r = subprocess.run(["/usr/bin/ditto", path, os.path.join(tmp, name)],
                           capture_output=True, text=True)
        if r.returncode != 0:
            notify(f"Couldn't download {name}: {r.stderr.strip() or 'copy failed'}")
            return 1
        dest = unique_name(DOWNLOADS, name)
        os.rename(os.path.join(tmp, name), dest)
    finally:
        shutil.rmtree(tmp, ignore_errors=True)
    if big:
        notify(f"Downloaded {name} to Downloads")
    subprocess.run(["/usr/bin/open", "-R", dest])
    return 0


def in_mount(path):
    return any(path == mp or path.startswith(mp.rstrip("/") + "/") for _, mp in mounted_servers())


def open_file(path, line):
    if line and os.path.isfile(path):
        for editor in ("/opt/homebrew/bin/code", "/usr/local/bin/code"):
            if os.access(editor, os.X_OK):
                subprocess.run([editor, "-g", f"{path}:{line}"])
                return
    subprocess.run(["/usr/bin/open", path])


def main():
    args = sys.argv[1:]
    ask = True
    if args and args[0] == "--no-confirm":
        ask = False
        args = args[1:]
    if not args or not args[0].strip():
        return 1
    text, line = clean(args[0])
    pwd = args[1] if len(args) > 1 else ""
    if len(args) > 2 and args[2].isdigit():
        line = args[2]
    if re.match(r"^[a-z][a-z0-9+.-]*://", text, re.I) or text.startswith("mailto:"):
        subprocess.run(["/usr/bin/open", text])
        return 0
    found = find(text, pwd)
    if found:
        remote = in_mount(found)
        action = click_action() if ask else "open"
        if action == "download" and not remote:
            action = "open"
        choice = confirm(found, remote) if action == "ask" else action.capitalize()
        if choice == "Open":
            open_file(found, line)
        elif choice == "Download":
            return download(found)
        elif choice == "Show in Finder":
            subprocess.run(["/usr/bin/open", "-R", found])
        return 0
    if "/" in text:
        notify(f"{text} isn't on this Mac or in a mounted server.")
    return 1


if __name__ == "__main__":
    sys.exit(main())
